              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidentes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Fuga de agua en el andén\",\n  \"descripcion\": \"Sale agua desde anoche\",\n  \"categoria\": \"infraestructura\",\n  \"subcategoria\": \"fuga_agua\",\n  \"lat\": \"{{lat}}\",\n  \"lng\": -74.0817,\n  \"radio_m\": 60\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idem_key\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"lat\", (4.55 + Math.random() * 0.3).toFixed(6));",
                  "// el body usa \"{{lat}}\" como texto: se convierte en número",
                  "pm.request.body.raw = pm.request.body.raw.replace('\"{{lat}}\"', pm.collectionVariables.get(\"lat\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const i = pm.response.json(); pm.collectionVariables.set(\"incidente_id\", i.id);",
                  "pm.test(\"Pendiente con prioridad calculada\", () => { pm.expect(i.estado).to.eql(\"pendiente\"); pm.expect([\"baja\",\"media\",\"alta\"]).to.include(i.prioridad); });",
                  "pm.test(\"Responde en menos de 3 s (RNF-REN-01)\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
